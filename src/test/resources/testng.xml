<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Full regression: every test in com.yerkkee.tests -->
<!-- parallel="methods": every test method runs in its own thread; safe because Playwright objects are ThreadLocal -->
<suite name="SauceDemo - Full" verbose="1" configfailurepolicy="continue" parallel="methods" thread-count="4">
    <!-- AllureArtifactsListener is registered via META-INF/services, so it also works with -Dtest and IDE runs -->

    <test name="All tests">
        <packages>
            <package name="com.yerkkee.tests"/>
        </packages>
    </test>
</suite>
