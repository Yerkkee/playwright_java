<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Smoke: fast critical-path checks. Run with -Dsuite.file=smoke.xml -->
<suite name="SauceDemo - Smoke" verbose="1">
    <listeners>
        <listener class-name="com.yerkkee.listeners.AllureArtifactsListener"/>
    </listeners>

    <test name="Smoke tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.yerkkee.tests"/>
        </packages>
    </test>
</suite>
