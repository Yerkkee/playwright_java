<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Smoke: fast critical-path checks. Run with -Dsuite.file=smoke.xml -->
<suite name="SauceDemo - Smoke" verbose="1" configfailurepolicy="continue" parallel="methods" thread-count="4">
    <!-- AllureArtifactsListener is registered via META-INF/services, so it also works with -Dtest and IDE runs -->

    <test name="Smoke tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.yerkkee.tests"/>
        </packages>
    </test>
</suite>
